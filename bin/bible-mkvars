#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]

proc parseScriptArguments {} {
   set parser [::brltty::ScriptArgumentsParser new]

   return [$parser parseArguments]
}

set argumentValues [parseScriptArguments]

set variables [list]
lappend variables [list BIBLE_ROOT $bible(root)]
lappend variables [list BIBLE_VERSION $bible(version)]

set oldFile [getVariablesFile]
set newFile "$oldFile.new"
file mkdir [file dirname $oldFile]

withChannel channel [open $newFile {WRONLY TRUNC CREAT}] {
   foreach variable $variables {
      lassign $variable name value
      puts $channel "$name=$value"
   }
}

refreshFile $newFile $oldFile 0
exit 0
