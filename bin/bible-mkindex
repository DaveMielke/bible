#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]

proc parseScriptArguments {} {
   set parser [::brltty::ScriptArgumentsParser new]

   $parser integerOption columnCount c columns count.3 "the number of book name columns" 1 5

   return [$parser parseArguments]
}

set argumentValues [parseScriptArguments]
set bookNameColumns [dict get $argumentValues columnCount]

proc makeTestamentIndex {testamentName firstBook lastBook} {
   global bookNameColumns

   set keys [lrange [getBookKeys] $firstBook $lastBook]
   set rows [expr {([llength $keys] + $bookNameColumns - 1) / $bookNameColumns}]
   set width "[expr {100 / $bookNameColumns}]%"

   addLine "<h3>[getTestamentTitle_$testamentName]</h3>"
   addLine "<table class=\"book-index\">"

   loop row 0 $rows {
      addLine "<tr>"

      loop column 0 $bookNameColumns {
         if {[clength [set key [lindex $keys [expr {($column * $rows) + $row}]]]] > 0} {
            addLine "<td>"
            addFileReference [getBookName $key] [getBookURL [getBookIndex $key]]
            addLine "</td>"
         }
      }

      addLine "</tr>"
   }

   addLine "</table>"
}

proc makeTestamentIndeces {} {
   makeTestamentIndex old 0 38
   makeTestamentIndex new 39 65
}
loadBookDefinitions
startBasicDocument index [getIndexTitle_book]
makeTestamentIndeces
endDocument
exit 0
