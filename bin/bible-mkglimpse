#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]

set optionDefinitions {
   {force flag "recreate the index"}
}

processProgramArguments optionValues $optionDefinitions

set versesFile [getVersesFile]
set indexDirectory [getGlimpseDirectory]
set indexFile [file join $indexDirectory .glimpse_index]
set indexPermissions 0o644

if {![file exists $indexFile]} {
   set action creating
} elseif {[file mtime $versesFile] > [file mtime $indexFile]} {
   set action updating
} elseif {$optionValues(force)} {
   set action recreating
} else {
   logDetail "index already created: $indexFile"
   exit 0
}

logNote "$action index: $indexFile"
file mkdir $indexDirectory

try {
   set output [exec << "" glimpseindex -o -B -H $indexDirectory $versesFile 2>@ stderr]
} trap {POSIX} {message} {
   internalError $message
}

foreach fileName [glob -directory $indexDirectory ".glimpse_*"] {
   file attributes $fileName -permissions $indexPermissions
}

exit 0
