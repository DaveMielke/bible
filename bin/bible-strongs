#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]
setStrongsSubstitutions substitutions

proc makeServerURL {} {
   global strongsLexicon strongsNumber strongsServer

   switch -exact $strongsServer {
      biblehub {
         return "https://bibleHub.com/$strongsLexicon/$strongsNumber.htm"
      }

      studybible {
         return "https://studyBible.info/strongs/[string toupper [string index $strongsLexicon 0]]$strongsNumber"
      }

      default {
         internalError "unexpected Strong's server: $strongsServer"
      }
   }
}

set lexiconKeywords {hebrew greek}
set serverKeywords {biblehub studybible}

if {[lempty $argv]} {
   cgiScript
   cgi_input

   cgiImport lexicon [lindex $lexiconKeywords 0]
   if {[set lexiconIndex [lsearch -exact $lexiconKeywords $lexicon]] < 0} {
      lappend problems $substitutions(problem.lexicon)
   } else {
      set strongsLexicon [lindex $lexiconKeywords $lexiconIndex]
   }

   cgiImport number 
   if {![testInteger $number $substitutions(lexicon.$strongsLexicon.minimum) $substitutions(lexicon.$strongsLexicon.maximum)]} {
      lappend problems $substitutions(problem.number)
   } else {
      set strongsNumber $number
   }

   cgiImport server [lindex $serverKeywords 0]
   if {[set serverIndex [lsearch -exact $serverKeywords $server]] < 0} {
      lappend problems $substitutions(problem.server)
   } else {
      set strongsServer [lindex $serverKeywords $serverIndex]
   }

   if {[info exists problems]} {
      startBasicDocument strongs.cgi [getStrongsTitle]
      cgi_content_type "text/html"

      addLine $substitutions(problem.statement)
      addLine "<ul>"

      foreach problem $problems {
         addLine "<li>$problem"
      }

      addLine "</ul>"
      endDocument stdout
   } else {
      cgi_redirect [makeServerURL]
   }
} else {
   proc getArgumentsUsageSummary {} {
      set lines [list]
      lappend lines "If no arguments (neither options nor parameters) are specified then the Strong's Results web page is generated."
      return $lines
   }

   set optionDefinitions {
   }

   addKeywordOption optionDefinitions lexicon "which lexicon to use" $lexiconKeywords
   addKeywordOption optionDefinitions server "the Strong's server to use" $serverKeywords
   processProgramArguments optionValues $optionDefinitions positionalArguments "word-number" getArgumentsUsageSummary

   verifyKeywordOption optionValues(lexicon) lexicon $lexiconKeywords
   set strongsLexicon $optionValues(lexicon)

   verifyKeywordOption optionValues(server) server $serverKeywords
   set strongsServer $optionValues(server)

   if {[nextElement positionalArguments number]} {
      verifyIntegerOption $number "word number" $substitutions(lexicon.$strongsLexicon.minimum) $substitutions(lexicon.$strongsLexicon.maximum)
      set strongsNumber $number
   } else {
      syntaxError "word number not specified"
   }

   puts stdout [makeServerURL]
}

exit 0
