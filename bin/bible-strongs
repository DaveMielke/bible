#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]
loadBookDefinitions

set lexiconKeywords {hebrew greek}

if {[lempty $argv]} {
   source [file join [getLibraryDirectory] "cgi.tcl"]

   proc cgiImport {parameter {default ""}} {
      upvar 1 $parameter $parameter

      if {[catch [list cgi_import $parameter] response] == 0} {
         set $parameter [string trim [set $parameter]]
         return 1
      }

      set $parameter $default
      return 0
   }

   startBasicDocument strongs.cgi [getStrongsTitle]
   setStrongsSubstitutions substitutions

   cgi_eval {
      cgi_content_type "text/html"
      cgi_input

      cgiImport lexicon [lindex $lexiconKeywords 0]
      if {[set lexiconIndex [lsearch -exact $lexiconKeywords $lexicon]] < 0} {
	 lappend problems $substitutions(problem.lexicon)
      } else {
	 set strongsLexicon [lindex $lexiconKeywords $lexiconIndex]
      }

      cgiImport number 
      if {![testInteger $number 1]} {
	 lappend problems $substitutions(problem.number)
      } else {
	 set strongsNumber $number
      }

      if {[info exists problems]} {
	 addLine $substitutions(problem.statement)
	 addLine "<ul>"

	 foreach problem $problems {
	    addLine "<li>$problem"
	 }

	 addLine "</ul>"
      } else {
         set url "https://biblehub.com/$strongsLexicon/$strongsNumber.htm"
         addLine "<p>Redirecting to: $url</p>"
         cgi_redirect $url
      }
   }

   endDocument stdout
} else {
   set optionDefinitions {
   }

   processProgramArguments optionValues $optionDefinitions
}

exit 0
