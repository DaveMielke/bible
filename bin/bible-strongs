#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]
setStrongsSubstitutions substitutions

proc getLexiconProperty {property} {
   global substitutions strongsLexicon
   return $substitutions(lexicon.$strongsLexicon.$property)
}

proc getNumberMinimum {} {
   return [getLexiconProperty minimum]
}

proc getNumberMaximum {} {
   return [getLexiconProperty maximum]
}

proc makeLookupURL {} {
   global strongsLexicon strongsNumber strongsServer

   switch -exact -- $strongsServer {
      biblehub {
         return "https://bibleHub.com/$strongsLexicon/$strongsNumber.htm"
      }

      studybible {
         return "https://studyBible.info/strongs/[string toupper [string index $strongsLexicon 0]]$strongsNumber"
      }

      default {
         internalError "unexpected server name: $strongsServer"
      }
   }
}

set lexiconNames {hebrew greek}
set serverNames {biblehub studybible}

if {[lempty $argv]} {
   cgiScript
   cgi_input

   cgiImport lexicon [lindex $lexiconNames 0]
   if {[set lexiconIndex [lsearch -exact $lexiconNames $lexicon]] < 0} {
      lappend problems $substitutions(problem.lexicon)
   } else {
      set strongsLexicon [lindex $lexiconNames $lexiconIndex]
   }

   cgiImport number 
   if {![testInteger $number [getNumberMinimum] [getNumberMaximum]]} {
      lappend problems $substitutions(problem.number)
   } else {
      set strongsNumber $number
   }

   cgiImport server [lindex $serverNames 0]
   if {[set serverIndex [lsearch -exact $serverNames $server]] < 0} {
      lappend problems $substitutions(problem.server)
   } else {
      set strongsServer [lindex $serverNames $serverIndex]
   }

   if {[info exists problems]} {
      startBasicDocument strongs.cgi [getStrongsTitle]
      cgi_content_type "text/html"

      addLine $substitutions(problem.statement)
      addLine "<ul>"

      foreach problem $problems {
         addLine "<li>$problem"
      }

      addLine "</ul>"
      endDocument stdout
   } else {
      cgi_redirect [makeLookupURL]
   }
} else {
   proc parseScriptArguments {} {
      set parser [::brltty::ScriptArgumentsParser new]
      $parser setPurpose "Look up a word within an online Strong's concordance."

      $parser stringOption lexiconName l lexicon name "which lexicon to use" $::lexiconNames
      $parser stringOption serverName s server name "the server on which to perform the lookup" $::serverNames
      $parser requiredParameter wordNumber word "the word number within the selected lexicon"

      $parser addNotes {
         "If no arguments (neither options nor parameters) are specified then the Strong's Results web page is generated."
      }

      return [$parser parseArguments]
   }

   set argumentValues [parseScriptArguments]
   set strongsLexicon [dict get $argumentValues lexiconName]
   set strongsServer [dict get $argumentValues serverName]
   set strongsNumber [dict get $argumentValues wordNumber]

   puts stdout [makeLookupURL]
}

exit 0
