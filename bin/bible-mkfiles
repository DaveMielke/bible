#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]

proc parseScriptArguments {} {
   set parser [::brltty::ScriptArgumentsParser new]

   return [$parser parseArguments]
}

set argumentValues [parseScriptArguments]

file mkdir [set hypertextDirectory [getHypertextDirectory]]

foreach fileName [glob -directory [set filesDirectory [getFilesDirectory]] -tails -nocomplain -- *] {
   set filePath [file join $filesDirectory $fileName]
   set oldPath [file join $hypertextDirectory $fileName]
   set newPath "$oldPath.new"

   file copy -force -- $filePath $newPath
   refreshFile $newPath $oldPath [file executable $filePath]
}

exit 0
