#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]

set optionDefinitions {
}

processProgramArguments optionValues $optionDefinitions

file mkdir [set hypertextDirectory [getHypertextDirectory]]
foreach name [glob -directory [set filesDirectory [getFilesDirectory]] -tails -nocomplain *] {
   set oldPath [file join $hypertextDirectory $name]
   set newPath "$oldPath.new"
   file copy -force -- [file join $filesDirectory $name] $newPath
   refreshFile $newPath $oldPath
}
exit 0
