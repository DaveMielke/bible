#!/usr/bin/env tclsh
source [file join [file dirname $argv0] .. lib bible.tcl]
setResultsSubstitutions substitutions
loadBookDefinitions

proc escapeString {string} {
   regsub -all {([-;,#<>^$(|).[*!\\])} $string {\\\1} string
   return $string
}

proc joinWords {operator} {
   global wordList
   set string ""
   set first 1
   foreach word $wordList {
      if {$first} {
         set first 0
      } else {
         append string $operator
      }
      append string [escapeString $word]
   }
   return $string
}

proc findVerses {code} {
   global searchMode caseSensitive spellingErrors
   bindVerseVariables

   set command [list < /dev/null glimpse -y -h -H [getGlimpseDirectory]]
   if {!$caseSensitive} {
      lappend command -i
   }
   lappend command -w
   lappend command -$spellingErrors
   lappend command -e

   switch -exact -- $searchMode {
      every {
         lappend command [joinWords \;]
      }

      any {
         lappend command [joinWords ,]
      }

      phrase {
         lappend command [joinWords " "]
      }

      default {
         internalError "unexpected search mode: $searchMode"
      }
   }

   if {[catch [list openInputStream "|$command"] stream] == 0} {
      uplevel 1 [list scanVerses $stream $code]
      catch [list close $stream]; unset stream
   } else {
      internalError "$stream"
   }
}

set caseKeywords {ignore respect}
set modeKeywords {every any phrase}
set styleKeywords {verses refs}

set errorsMinimum 0
set errorsMaximum 8

if {[lempty $argv]} {
   cgiScript
   cgi_input

   if {![cgiImport data ""]} {
      lappend problems $substitutions(input.empty)
   } else {
      set wordList [split $data]
   }

   cgiImport mode [lindex $modeKeywords 0]
   if {[set modeIndex [lsearch -exact $modeKeywords $mode]] < 0} {
      lappend problems $substitutions(mode.problem)
   } else {
      set searchMode [lindex $modeKeywords $modeIndex]
   }

   cgiImport case [lindex $caseKeywords 0]
   if {[set caseIndex [lsearch -exact $caseKeywords $case]] < 0} {
      lappend problems $substitutions(case.problem)
   } else {
      set caseSensitive $caseIndex
   }

   cgiImport errors $errorsMinimum
   if {![testInteger $errors $errorsMinimum $errorsMaximum]} {
      lappend problems $substitutions(errors.problem)
   } else {
      set spellingErrors $errors
   }

   cgiImport style [lindex $styleKeywords 0]
   if {[set styleIndex [lsearch -exact $styleKeywords $style]] < 0} {
      lappend problems $substitutions(style.problem)
   } else {
      set resultStyle [lindex $styleKeywords $styleIndex]
   }

   startBasicDocument search.cgi [getResultsTitle]
   cgi_content_type "text/html"

   if {[info exists problems]} {
      addLine $substitutions(statement.problem)
      addLine "<ul>"
      foreach problem $problems {
         addLine "<li>$problem"
      }
      addLine "</ul>"
   } else {
      addLine "<form method=\"get\" action=\"search.cgi\">"
      addLine "<input name=\"data\" type=\"text\" value=\"$data\" size=\"40\">"
      addLine "<input type=\"submit\" value=\"$substitutions(label.search)\">"
      addLine "<ul>"

      addLine "<li>"
      addSelector mode $mode $modeKeywords [list $substitutions(mode.every) $substitutions(mode.any) $substitutions(mode.phrase)]

      addLine "<li>"
      addSelector case $case $caseKeywords [list $substitutions(case.ignore) $substitutions(case.respect)]

      addLine "<li>"
      for {set i $errorsMinimum} {$i <= $errorsMaximum} {incr i} {
         lappend internalErrorsList $i
         lappend externalErrorsList [getResults_errorsLimit $i]
      }
      addSelector errors $errors $internalErrorsList $externalErrorsList

      addLine "<li>"
      addSelector style $style $styleKeywords [list $substitutions(style.verses) $substitutions(style.refs)]

      addLine "</ul>"
      addLine "</form>"

      set countMark [markDocument]
      set verseCount 0

      switch -exact -- $resultStyle {
         verses {
            findVerses {
               if {[incr verseCount] == 1} {
                  addLine "<dl>"
               }
               htmlizeVerseText verseText
               set url [getBookIdentifier $bookKey]
               set link "[getBookName $bookKey] "
               if {[getChapterCount $bookKey] > 0} {
                  append url "/[getChapterName $chapterNumber]"
                  append link "$chapterNumber:"
               }
               append url ".html#$verseNumber"
               append link $verseNumber
               addLine "<dt><a href=\"$url\">$link</a><dd>$verseText"
            }
            if {$verseCount > 0} {
               addLine "</dl>"
            }
         }

         refs {
            set currentBook ""
            findVerses {
               if {[incr verseCount] == 1} {
                  addLine "<dl>"
               }
               if {![cequal $bookKey $currentBook]} {
                  if {[clength $currentBook] > 0} {
                     addLine $refs
                  }
                  set currentBook $bookKey
                  set currentChapter ""
                  addLine "<dt>[getBookName $bookKey]<dd>"
                  set refs ""
                  set urlPrefix [getBookIdentifier $bookKey]
               }
               set url $urlPrefix
               set refPrefix ""
               set sameChapter 0
               if {[getChapterCount $bookKey] > 0} {
                  append url "/[getChapterName $chapterNumber]"
                  if {[cequal $chapterNumber $currentChapter]} {
                     set sameChapter 1
                  } else {
                     set currentChapter $chapterNumber
                     set refPrefix "$chapterNumber:"
                  }
               }
               append url ".html#$verseNumber"
               if {$sameChapter} {
                  append refs ","
               } elseif {[clength $refs] > 0} {
                  append refs " "
               }
               append refs "$refPrefix<a href=\"$url\">$verseNumber</a>"
            }
            if {$verseCount > 0} {
               addLine $refs
               addLine "</dl>"
            }
         }
      }

      if {$verseCount > 0} {
         addLine $substitutions(statement.end)
      }

      insertLine $countMark "<h3>[getResults_versesFound $verseCount]</h3>"
      addSearchHelpParagraph
   }

   endDocument stdout
} else {
   proc getArgumentsUsageSummary {} {
      set lines [list]
      lappend lines "If no arguments (neither options nor parameters) are specified then the Search Results web page is generated."
      return $lines
   }

   set optionDefinitions {
      {case flag "respect case when matching"}
      {noheaders flag "don't show the verse table column headers"}
   }

   addKeywordOption optionDefinitions search mode "how to search for the specified words" $modeKeywords
   addIntegerOption optionDefinitions errors count "how many spelling errors to allow" $errorsMinimum $errorsMaximum
   processProgramArguments optionValues $optionDefinitions wordList "word ..." getArgumentsUsageSummary
   verifyKeyword optionValues(search) "search mode" $modeKeywords

   set searchMode $optionValues(search)
   set caseSensitive $optionValues(case)

   if {[info exists optionValues(errors)]} {
      verifyInteger $optionValues(errors) "spelling errors count" $errorsMinimum $errorsMaximum
      set spellingErrors $optionValues(errors)
   } else {
      set spellingErrors $errorsMinimum
   }

   if {[lempty $wordList]} {
      syntaxError "word not specified"
   }

   set verseTable [list]
   findVerses {
      lappend verseTable [list [getBookName $bookKey] "$chapterNumber:$verseNumber" $verseText]
   }

   if {[lempty $verseTable]} {
      semanticError "verse not found"
   }

   if {!$optionValues(noheaders)} {
      lvarpush verseTable [list Book Verse Text]
   }

   puts -nonewline stdout [formatTable $verseTable 1 {{right} {left} {left}}]
}

exit 0
