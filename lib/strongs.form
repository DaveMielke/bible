<form method="get" action="strongs.cgi">
  <br><span class="form-label">@label.lexicon@:</span>
  <select name="lexicon" id="lexiconSelector">
  <option value="hebrew" selected>@lexicon.hebrew@
  <option value="greek">@lexicon.greek@
  </select>

  <br><span class="form-label">@label.number@:</span>
  <input type="text" name="number" size="7" maxlength="4" id="numberText">
  <div class="form-error" id="numberError"></div>

  <br><span class="form-label">@label.server@:</span>
  <select name="server" id="serverSelector">
  <option value="biblehub" selected>@server.biblehub@
  <option value="studybible">@server.studybible@
  </select>

  <br><input type="submit" value="@label.submit@" id="submitButton">
</form>

<script>
  const lexiconSelector = document.getElementById("lexiconSelector");
  const numberText = document.getElementById("numberText");
  const numberError = document.getElementById("numberError");
  const submitButton = document.getElementById("submitButton");

  function checkNumber () {
    let message = null;
    const number = parseInt(numberText.value, 10);

    if (isNaN(number)) {
      message = "not an integer";
    } else {
      numberError.textContent = "";
      submitButton.disabled = false;
      return;
    }

    numberError.textContent = message;
    submitButton.disabled = true;
  }

  numberText.addEventListener("input",
    function () {
      checkNumber();
    }
  );

  checkNumber();
</script>
