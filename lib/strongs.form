<form method="get" action="strongs.cgi">
  <br><label for="lexiconSelector">@label.lexicon@:</label>
  <select name="lexicon" id="lexiconSelector">
  <option value="hebrew" selected>@lexicon.hebrew.label@</option>
  <option value="greek">@lexicon.greek.label@</option>
  </select>

  <br><label for="numberText">@label.number@:</label>
  <input
    name="number" id="numberText"
    type="text" inputmode="numeric"
    size="7" maxlength="4"
  >
  <div class="form-error" id="numberError"></div>

  <br><label for="serverSelector">@label.server@:</label>
  <select name="server" id="serverSelector">
  <option value="biblehub" selected>@server.biblehub@</option>
  <option value="studybible">@server.studybible@</option>
  </select>

  <br><input type="submit" value="@label.submit@" id="submitButton">
</form>

<script>
  const lexiconSelector = document.getElementById("lexiconSelector");
  const numberText = document.getElementById("numberText");
  const numberError = document.getElementById("numberError");
  const submitButton = document.getElementById("submitButton");

  const lexiconProperties = {
    hebrew: {
      minimum: @lexicon.hebrew.minimum@,
      maximum: @lexicon.hebrew.maximum@,
    },

    greek: {
      minimum: @lexicon.greek.minimum@,
      maximum: @lexicon.greek.maximum@,
    },
  };

  function checkNumber () {
    let message = null;
    const text = numberText.value;

    if (text.length > 0) {
      const regex = /^\s*(0|-?[1-9][0-9]*)\s*$/;
      const matches = text.match(regex);

      if (matches) {
        const value = parseInt(matches[1], 10);
        const lexicon = lexiconProperties[lexiconSelector.value];
        const minimum = lexicon.minimum;
        const maximum = lexicon.maximum;

        if (value < minimum) {
          message = "word number is less than " + minimum;
        } else if (value > maximum) {
          message = "word number is greater than " + maximum;
        } else {
          numberError.textContent = "";
          submitButton.disabled = false;
          return;
        }
      } else {
        message = "word number must be an integer";
      }
    } else {
      message = "word number is required";
    }

    numberError.textContent = message;
    submitButton.disabled = true;
  }

  numberText.addEventListener("input",
    function () {
      checkNumber();
    }
  );

  lexiconSelector.addEventListener("change",
    function () {
      numberText.value = "";
      checkNumber();
    }
  );

  checkNumber();
</script>
